/* ─────────────────────────────
   NAV — CLEAN / PREMIUM TABS
───────────────────────────── */

.nav {
  padding: 14px 28px;
  border-bottom: 0.5px solid var(--rule);
}

.nav-brand img {
  height: 16px;
  opacity: 0.9;
}

.nav-pills {
  display: flex;
  gap: 16px;
}

.nav-pill {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.18em;
  color: rgba(242,238,229,0.35);
  text-transform: uppercase;
  padding: 0;
  border: none;
  background: none;
  position: relative;
}

/* subtle underline system */
.nav-pill::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 0%;
  height: 1px;
  background: var(--gold);
  transition: width 0.25s ease;
  opacity: 0.8;
}

.nav-pill:hover {
  color: var(--cream);
}

.nav-pill:hover::after {
  width: 100%;
}

/* ACTIVE STATE (important) */
.nav-pill.active {
  color: var(--cream);
}

.nav-pill.active::after {
  width: 100%;
}
